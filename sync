#!/usr/bin/env bash

fd -H -t l -E 'archlinux/*' . "$HOME" | while IFS= read -r f; do
  target=$(readlink -f "$f")
  case "$target" in
  "$HOME"/archlinux/*) ;;
  *) continue ;;
  esac
  if [ ! -e "$f" ]; then
    rm -rf "$f"
    continue
  fi
  if [ -d "$f" ] && [ -z "$(fd -H . "$f" -L --max-depth 1)" ]; then
    rm -rf "$f" "$target"
    continue
  fi
  echo "$f"
done | sed "s|^$HOME/||" | sort >"$HOME/archlinux/generated/symlinks"

pacman -Qqen >"$HOME/archlinux/generated/pacman.packages"
pacman -Qqem >"$HOME/archlinux/generated/yay.packages"

# ------------------------------------------------

yay -Syu --noconfirm              # full system + AUR upgrade
yay -Rns $(yay -Qtdq) --noconfirm # remove orphaned packages
yay -Sc --noconfirm               # clean package cache

repos=(
  "$HOME/hw"
  "$HOME/archlinux"
  "$HOME/personal/profile"
)
for repo in "${repos[@]}"; do
  printf "\n==> %s\n" "$repo"
  git -C "$repo" add -A
  git -C "$repo" commit -m "chore: routine update"
  git -C "$repo" push origin main
done

roots=(
  # ~/projects
  ~/.src
)
find "${roots[@]}" -name .git -type d -print0 | while IFS= read -r -d '' d; do
  repo="${d%/.git}"
  printf "\n==> %s\n" "$repo"
  git -C "$repo" fetch origin
  git -C "$repo" reset --hard "origin/$(git -C "$repo" symbolic-ref --short HEAD)"
  git -C "$repo" pull
done

~/archlinux/util/common

# ------------------------------------------------

USB="/run/media/iqrar/IQRAR_USB"
if [ -e "$USB" ] || udisksctl mount -b "/dev/disk/by-label/IQRAR_USB"; then
  rm -rf "$USB/personal"
  cp -r "$HOME/personal" "$USB"
fi

MTP=$(find "/run/user/1000/gvfs/" -maxdepth 1 -iname 'mtp:host=*')
if [ -e "$MTP" ] || gio mount "$(gio mount -li | grep -m1 -oP 'activation_root=\Kmtp://\S+')"; then
  echo "MTP accessible..."
  rm -rf "$MTP/Internal storage/personal"
  cp -r "$HOME/personal" "$MTP/Internal storage"
fi
