function blerc/vim-mode-hook {
  ble-bind -m vi_nmap -f C-m accept-line
  ble-bind -m vi_xmap -f C-m accept-line
  ble-bind -m vi_imap -f C-m accept-line

  ble-bind -m vi_nmap -f C-c discard-line
  ble-bind -m vi_xmap -f C-c discard-line
  ble-bind -m vi_imap -f C-c discard-line

  ble-bind -m vi_imap -f S-RET newline
  ble-bind -m auto_complete -f S-RET newline
  ble-bind -m menu_complete -f S-RET newline

  ble-bind -m vi_imap -f C-f 'history-search forward:hide-status'
  ble-bind -m vi_imap -f C-s   'history-search backward:hide-status'
  ble-bind -m auto_complete -f C-f 'history-search forward:hide-status'
  ble-bind -m auto_complete -f C-s 'history-search backward:hide-status'
  ble-bind -m nsearch       -f C-f nsearch/forward
  ble-bind -m nsearch       -f C-s nsearch/backward

  ble-bind -m vi_nmap -f C-y redo
  ble-bind -m auto_complete -f C-a auto_complete/accept-line

  ble-bind -m vi_nmap -c 'C-o' 'cd ..'
  ble-bind -m vi_nmap -c 'SP a a' 'cd -'
  ble-bind -m vi_nmap -c 'SP a c' 'source ~/.bashrc'

  # ------------------------------------------------

  # my/toggle PRE POST: wrap the line in PRE/POST, or unwrap it if already wrapped
  function my/toggle {
    local s=$_ble_edit_str pre=$1 post=$2
    s=${s#"${s%%[![:space:]]*}"};       s=${s%"${s##*[![:space:]]}"}
    pre=${pre#"${pre%%[![:space:]]*}"}; post=${post%"${post##*[![:space:]]}"}
    if [[ $s == "$pre"*"$post" ]]; then s=${s#"$pre"}; s=${s%"$post"}; else s=$pre$s$post; fi
    ble/widget/.replace-range 0 "${#_ble_edit_str}" "$s"
    _ble_edit_ind=${#s}
  }

  # my/snippet KEYSEQ TEMPLATE [KEYMAP]  ("{}" = current command line)
  function my/snippet {
    local t=$2 name=my/toggle-${1//[^[:alnum:]]/_} pre post
    [[ $t == *'{}'* ]] || t+=' {}'
    printf -v pre %q "${t%%'{}'*}"; printf -v post %q "${t#*'{}'}"
    builtin eval "function ble/widget/$name { my/toggle $pre $post; }"
    ble-bind -m "${3:-vi_nmap}" -f "$1" "$name"
  }

  my/snippet 'SP a f' '{} | fzf'
  my/snippet 'SP a s' 'sudo {}'
  my/snippet 'SP a r' 'sudo pacman -Rns --noconfirm {}'
  my/snippet 'SP a i' 'sudo pacman -S --needed --noconfirm {}'
  my/snippet 'SP a R' 'yay -Rns --noconfirm {}'
  my/snippet 'SP a I' 'yay -S --needed --noconfirm {}'

  # ------------------------------------------------

  ble-import lib/vim-surround

  bleopt complete_auto_menu=1
  bleopt menu_prefix='\e[1;31m%d \e[m'
  bind 'set completion-ignore-case on'

  bleopt edit_magic_accept=sabbrev:verify-syntax
  bleopt exec_exit_mark=
  bleopt exec_errexit_mark=
  bleopt keymap_vi_mode_show=
  bleopt prompt_vi_mode_indicator=
  bleopt prompt_eol_mark=''

  ble-bind -m vi_cmap --cursor 5
  ble-bind -m vi_imap --cursor 5
  ble-bind -m vi_nmap --cursor 2
  ble-import lib/vim-surround
  ble-import -d integration/fzf-completion
  ble-import -d integration/fzf-key-bindings
  bleopt complete_auto_menu=1
  bleopt prompt_vi_mode_indicator=
  ble-face auto_complete=fg=245
  stty time 0
  bind 'set keyseq-timeout 1'
}
blehook/eval-after-load keymap_vi blerc/vim-mode-hook
