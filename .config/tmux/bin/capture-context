#!/usr/bin/env bash

mode="${1:?usage: capture-context.sh view|buffer}"
FILE="/tmp/ai_context_$(date +time_%Y-%m-%dT%H-%M-%S).txt"

if [[ "$mode" == "buffer" ]]; then
    tmux capture-pane -pJ -S -32768 > "$FILE"
else
    tmux capture-pane -pJ > "$FILE"
fi

sed -i 's/[ \t]*$//' "$FILE"
tac "$FILE" | sed '/./,$!d' | tac > "$FILE.tmp" && mv "$FILE.tmp" "$FILE"

printf 'file://%s\n' "$FILE" | wl-copy --type text/uri-list

hyprctl dispatch "hl.dsp.focus({ workspace = \"1\" })" >/dev/null
~/archlinux/.config/hypr/bin/paste
