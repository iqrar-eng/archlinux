#!/usr/bin/env bash

term_flag=0
for arg in "$@"; do
  if [[ "$arg" == "--term" ]]; then
    term_flag=1
  fi
done

if [[ -z $TMUX ]] && [[ -z $(pgrep tmux) ]]; then
  tmux new "nvim" \; neww -d \; neww -d
else
  tmux attach
fi

tmux switch-client -t :1

if [[ $term_flag -eq 1 ]]; then
  tmux last-window
fi

hyprctl dispatch 'hl.dsp.focus({ workspace = "2" })' >/dev/null
