#!/bin/bash

MY_ID=123456

PATHS=()
for arg in "$@"; do
  PATHS+=("$(realpath -sm -- "$arg")")
done

ya emit-to "$MY_ID" plugin autosave ${PATHS:+load} "${PATHS[@]}" 2>/dev/null ||
  kitty --class kitty-yazi -e yazi --client-id "$MY_ID" "${PATHS[@]}"

hyprctl dispatch 'hl.dsp.focus({ workspace = "5" })' >/dev/null
