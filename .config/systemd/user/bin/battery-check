#!/usr/bin/env bash

LOW_THRESHOLD=35
LOW_STATE_FILE="/tmp/battery-low-notified"
CAPACITY=$(cat /sys/class/power_supply/BAT0/capacity)
STATUS=$(cat /sys/class/power_supply/BAT0/status)

if [ "$CAPACITY" -lt "$LOW_THRESHOLD" ] && [ "$STATUS" != "Charging" ]; then
  dunstctl close-all
  notify-send -u critical "${CAPACITY}%"
  touch "$LOW_STATE_FILE"
else
  if [ -f "$LOW_STATE_FILE" ]; then
    dunstctl close-all
  fi
  rm -f "$LOW_STATE_FILE"
fi
